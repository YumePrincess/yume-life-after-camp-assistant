{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "yume-camp-assistant",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-02",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "run_worker_first": [
      "/",
      "/index.html",
      "/api/*",
      "/auth/*",
      "/admin",
      "/login",
      "/chat",
      "/chat/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "yume-camp-assistant",
      "database_id": "b16d4be3-f4da-4cbb-956f-916471a90578",
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "LIVE_UPDATES",
        "class_name": "LiveUpdates"
      },
      {
        "name": "AGENT_LOGS",
        "class_name": "AgentLogStream"
      },
      {
        "name": "CHANNEL_ROOM",
        "class_name": "ChatRoom"
      },
      {
        "name": "USER_INBOX",
        "class_name": "ChatInbox"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "LiveUpdates"
      ]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": [
        "AgentLogStream"
      ]
    },
    {
      "tag": "v3-chat",
      "new_sqlite_classes": [
        "ChatRoom",
        "ChatInbox"
      ]
    }
  ],
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  },
  // Optional secrets: OIDC_CLIENT_SECRET (for OIDC), ADMIN_TEMPORARY_KEY (shared admin Key login).
  // Configure optional secrets with `wrangler secret put`; keep secret values out of vars.
  "secrets": {
    "required": [
      "SESSION_SECRET",
      "AGENT_SHARED_TOKEN"
    ]
  },
  "vars": {
    "ENVIRONMENT": "production",
    "OIDC_ENABLED": "true",
    "OIDC_ISSUER": "https://account.example.com",
    "OIDC_CLIENT_ID": "0cfa870bf0e80e08b65fbf5b44664f77a8c04dc38f73e62b47884591e214890c",
    "OIDC_REDIRECT_URI": "https://lifeafter.example.com/auth/oidc/callback",
    "OIDC_POST_LOGOUT_REDIRECT_URI": "https://lifeafter.example.com/",
    "OIDC_ALLOWED_SUBJECTS": "REPLACE_WITH_OIDC_SUB",
    "OIDC_SCOPES": "openid email profile",
    "OIDC_EMAIL_CLAIM": "email",
    "OIDC_AUTO_LOGIN": "true",
    "OIDC_TOKEN_AUTH_METHOD": "client_secret_post",
    "OIDC_SESSION_CHECK_INTERVAL_SECONDS": "5",
    "STORAGE_PREFIX": "lifeafter"
  },
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "yume-oss"
    }
  ]
}
