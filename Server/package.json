{
  "name": "mrzh-camp-assistant-server",
  "version": "0.2.0",
  "private": true,
  "description": "LifeAfter camp assistant API and web UI on Cloudflare Workers, Assets, and D1",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "wrangler dev --config wrangler.jsonc --test-scheduled",
    "deploy": "wrangler deploy --config wrangler.jsonc",
    "deploy:dry": "wrangler deploy --config wrangler.example.jsonc --dry-run",
    "types": "wrangler types --config wrangler.jsonc --strict-vars false",
    "types:check": "wrangler types --config wrangler.example.jsonc --strict-vars false --check",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run types:check && npm run typecheck && npm test && npm run deploy:dry"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260726.1",
    "typescript": "^7.0.2",
    "vitest": "^3.2.4",
    "wrangler": "4.114.0"
  }
}
